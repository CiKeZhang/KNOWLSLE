# 环境变量参考。本地开发可复制为 .env;生产环境请在云托管「服务配置 → 环境变量」中注入,
# 不要把真实密钥写进代码仓库或部署包。

# ---- 数据库 ----
# 云托管容器内使用绝对路径;把持久卷挂到 DATA_DIR 后,数据与备份即可跨部署保留
DATABASE_URL="file:/app/data/kygl.db"
DATA_DIR="/app/data"
# 留空表示 $DATA_DIR/backups
BACKUP_DIR=""

# ---- 服务 ----
PORT=3000
NODE_ENV=production

# ---- 鉴权 / 加密(生产必须替换为随机值) ----
JWT_SECRET="change_me_to_a_random_32_byte_string"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="change_me_to_a_random_32_byte_string"
WECHAT_APPID=""
WECHAT_SECRET=""

# ---- 测试登录(仅用于联调,正式上线建议配置强口令或关闭该接口) ----
TEST_LOGIN_SECRET=""

# ---- 数据库传输接口(升级前导出 / 升级后回灌) ----
# 留空 = 只接受系统管理员 Bearer Token;配置后也可用请求头 x-db-transfer-secret 走运维通道
DB_TRANSFER_SECRET=""
# 设为 true 可彻底关闭导出/导入接口
DISABLE_DB_TRANSFER=false

# ---- 可选 ----
REDIS_URL=""
CORS_ORIGINS=""
UPLOAD_DIR="./uploads"
