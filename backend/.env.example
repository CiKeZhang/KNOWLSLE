# 环境变量模板 - Docker 部署时复制为 .env 并填写真实值
# cp .env.example .env
#
# 生成随机密钥:
#   openssl rand -hex 32

# 服务端口(容器内)
PORT=3000

# 数据库(容器内由 docker-compose 覆盖为 file:/app/data/kygl.db)
DATABASE_URL="file:./dev.db"

# JWT 密钥 - 生产环境必须替换
JWT_SECRET="please_change_jwt_secret_in_production"
JWT_EXPIRES_IN="7d"

# 敏感数据加密密钥(AES-256-GCM) - 生产环境必须替换,更换后旧密文无法解密
ENCRYPTION_KEY="please_change_encryption_key_in_production"

# 跨域来源(小程序端不校验,浏览器端调试用)
CORS_ORIGINS=""

# 文件与备份目录
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"

# Redis(可选,留空则不启用)
REDIS_URL=""

# 大模型(可选,留空则 AI 仅用规则算法)
LLM_API_BASE="https://open.bigmodel.cn/api/paas/v4"
LLM_API_KEY=""
LLM_MODEL="glm-4-flash"

# 微信小程序 - 在 mp.weixin.qq.com 后台获取
WECHAT_APPID=""
WECHAT_SECRET=""
