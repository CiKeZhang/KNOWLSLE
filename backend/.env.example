# 后端环境变量(本地开发参考,生产环境通过 docker-compose 注入)
# 复制为 .env 并修改

# 数据库
DATABASE_URL="mysql://kygl:kygl_pwd_2026@localhost:3306/kygl?charset=utf8mb4"

# Redis(可选,用于缓存与限流)
REDIS_URL="redis://:kygl_redis_2026@localhost:6379/0"

# JWT
JWT_SECRET="please_change_jwt_secret_in_production"
JWT_EXPIRES_IN="12h"

# 服务
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"

# 文件上传与备份目录
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"

# AI 大模型(可选;不配置则 AI 推荐仅使用规则算法,留言板审核使用关键词兜底)
# 留言板 AI 审核、AI 择校 Agent 对话均使用此配置
LLM_API_BASE="https://open.bigmodel.cn/api/paas/v4"
LLM_API_KEY=""
LLM_MODEL="glm-4-flash"

# 敏感数据加密密钥(AES-256-GCM,用于加密学生考研成绩/目标院校等敏感字段)
# 生产环境必须修改为随机 32 字节以上的字符串
ENCRYPTION_KEY="please_change_encryption_key_in_production"

# 微信小程序(学生端登录)
# 在微信公众平台 https://mp.weixin.qq.com 注册小程序后获取
WECHAT_APPID="wx90701cfccf66ac74"
WECHAT_SECRET="your_app_secret_here"
