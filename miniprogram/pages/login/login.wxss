.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #409EFF 0%, #337ecc 50%, #f5f7fa 50%);
  padding: 0 48rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.logo-area {
  padding-top: 15vh;
  text-align: center;
  margin-bottom: 80rpx;
  flex-shrink: 0;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-area {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.step-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.step-desc {
  margin-bottom: 40rpx;
}

.btn-wechat {
  width: 100%;
  background: #07C160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.btn-phone {
  width: 100%;
  background: #409EFF;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.btn-skip {
  width: 100%;
  background: transparent;
  color: #909399;
  font-size: 28rpx;
}

.btn-confirm {
  width: 100%;
  background: #409EFF;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-top: 32rpx;
}

.privacy-agree {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #409EFF;
  border-color: #409EFF;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.agree-text {
  font-size: 26rpx;
  color: #999;
}

.privacy-link {
  font-size: 26rpx;
  color: #409EFF;
}

.tip {
  text-align: center;
  margin-top: 24rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #606266;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-tip {
  font-size: 24rpx;
  color: #909399;
  margin-top: -8rpx;
  margin-bottom: 24rpx;
}

.role-switch {
  display: flex;
  background: #f0f2f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}
.role-item {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #606266;
  border-radius: 10rpx;
}
.role-item.active {
  background: #409eff;
  color: #fff;
  font-weight: 600;
}

.picker-value {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  color: #303133;
}
.picker-value.placeholder {
  color: #c0c4cc;
}
