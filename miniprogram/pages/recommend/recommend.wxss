.form-item { margin-bottom: 24rpx; }
.label { display: block; color: #606266; font-size: 26rpx; margin-bottom: 8rpx; }
.input { width: 100%; height: 80rpx; border: 2rpx solid #e4e7ed; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; }
.btn-generate { width: 100%; background: #409EFF; color: #fff; border-radius: 48rpx; font-size: 30rpx; margin-top: 16rpx; }
.school-name { font-size: 32rpx; font-weight: 600; }
.metrics { display: flex; justify-content: space-around; margin: 16rpx 0; padding: 16rpx 0; background: #f5f7fa; border-radius: 12rpx; }
.metric { text-align: center; }
.m-label { display: block; font-size: 22rpx; color: #909399; }
.m-value { font-size: 30rpx; font-weight: 600; color: #409EFF; }
.reason, .risk { font-size: 26rpx; line-height: 1.6; margin-top: 8rpx; }
.reason-label, .risk-label { font-weight: 600; }
.risk { color: #E6A23C; }
.btn-reset { width: 100%; background: #f5f7fa; color: #606266; border-radius: 48rpx; margin-bottom: 24rpx; }
