.status-card { margin-bottom: 24rpx; }
.card-done { background: linear-gradient(135deg, #67C23A, #85ce61); }
.card-pending { background: linear-gradient(135deg, #E6A23C, #f0b552); }
.status-title { font-size: 32rpx; font-weight: 600; color: #fff; margin-bottom: 8rpx; }
.status-sub { font-size: 24rpx; color: rgba(255,255,255,0.9); }
.status-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.required { color: #F56C6C; }

.stage-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stage-item {
  padding: 20rpx 0;
  text-align: center;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #606266;
  background: #fff;
}

.stage-item.active {
  border-color: #409EFF;
  background: #ecf5ff;
  color: #409EFF;
  font-weight: 600;
}

.check-list { display: flex; flex-direction: column; gap: 16rpx; }

.check-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  flex-shrink: 0;
}

.checkbox.checked { background: #409EFF; border-color: #409EFF; }

.check-text { font-size: 28rpx; color: #606266; }

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.form-row:last-child { border-bottom: none; }

.row-label { width: 180rpx; font-size: 28rpx; color: #606266; }
.row-input { flex: 1; font-size: 28rpx; }
.row-slider { flex: 1; margin: 0 16rpx; }
.progress-value { width: 80rpx; text-align: right; color: #409EFF; font-size: 26rpx; }

.btn-submit {
  width: 100%;
  background: #409EFF;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-top: 16rpx;
}

.btn-makeup {
  width: 100%;
  background: #E6A23C;
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.detail-row:last-child { border-bottom: none; }

.detail-label { width: 180rpx; color: #909399; font-size: 28rpx; flex-shrink: 0; }
.detail-value { flex: 1; font-size: 28rpx; color: #303133; }

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.history-item:last-child { border-bottom: none; }

.history-week { font-size: 28rpx; }
