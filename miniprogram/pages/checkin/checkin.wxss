.status-card { margin-bottom: 24rpx; }
.card-done { background: linear-gradient(135deg, #67C23A, #85ce61); }
.card-pending { background: linear-gradient(135deg, #E6A23C, #f0b552); }
.status-title { font-size: 32rpx; font-weight: 600; color: #fff; margin-bottom: 8rpx; }
.status-sub { font-size: 24rpx; color: rgba(255,255,255,0.9); }
.status-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.required { color: #F56C6C; }

.stage-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stage-item {
  padding: 20rpx 0;
  text-align: center;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #606266;
  background: #fff;
}

.stage-item.active {
  border-color: #409EFF;
  background: #ecf5ff;
  color: #409EFF;
  font-weight: 600;
}

.check-list { display: flex; flex-direction: column; gap: 16rpx; }

.check-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  flex-shrink: 0;
}

.checkbox.checked { background: #409EFF; border-color: #409EFF; }

.check-text { font-size: 28rpx; color: #606266; }

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.form-row:last-child { border-bottom: none; }

.row-label { width: 180rpx; font-size: 28rpx; color: #606266; }
.row-input { flex: 1; font-size: 28rpx; }
.row-slider { flex: 1; margin: 0 16rpx; }
.progress-value { width: 80rpx; text-align: right; color: #409EFF; font-size: 26rpx; }

.checkbox-row { justify-content: space-between; }

/* 开关样式 */
.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #dcdfe6;
  position: relative;
  transition: background 0.3s;
}

.switch.on {
  background: #67C23A;
}

.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
  transition: left 0.3s;
}

.switch.on .switch-dot {
  left: 44rpx;
}

.form-tip {
  font-size: 24rpx;
  color: #909399;
  padding: 12rpx 0 4rpx;
  line-height: 1.5;
}

.btn-submit {
  width: 100%;
  background: #409EFF;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-top: 16rpx;
}

.btn-makeup {
  width: 100%;
  background: #E6A23C;
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.detail-row:last-child { border-bottom: none; }

.detail-label { width: 180rpx; color: #909399; font-size: 28rpx; flex-shrink: 0; }
.detail-value { flex: 1; font-size: 28rpx; color: #303133; }
.detail-value.success { color: #67C23A; font-weight: 600; }

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.history-item:last-child { border-bottom: none; }

.history-week { font-size: 28rpx; }

/* ========== 分科复习进度展示 ========== */
.progress-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f2f5;
}
.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
}
.progress-update {
  font-size: 26rpx;
  color: #409EFF;
}
.muted {
  font-size: 24rpx;
  color: #909399;
  padding: 16rpx 0 4rpx;
  line-height: 1.5;
}

/* 单科卡片 */
.subject { margin-bottom: 28rpx; }
.subject:last-child { margin-bottom: 0; }
.subject-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.subject-name { font-size: 28rpx; font-weight: 600; color: #303133; }
.subject-percent { font-size: 26rpx; color: #409EFF; }
.bar {
  height: 12rpx;
  background: #f0f2f5;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #409EFF, #66b1ff);
  border-radius: 6rpx;
}
.chapter-list { display: flex; flex-wrap: wrap; }
.chapter {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 28rpx;
  margin: 0 16rpx 16rpx 0;
  border: 2rpx solid #dcdfe6;
  background: #fff;
}
.chapter-name { font-size: 24rpx; color: #606266; margin-right: 10rpx; }
.chapter-round { font-size: 22rpx; color: #909399; }
.chapter.round-1 { border-color: #b3d8ff; background: #ecf5ff; }
.chapter.round-1 .chapter-name, .chapter.round-1 .chapter-round { color: #409EFF; }
.chapter.round-2 { border-color: #f5dab1; background: #fdf6ec; }
.chapter.round-2 .chapter-name, .chapter.round-2 .chapter-round { color: #E6A23C; }
.chapter.round-3 { border-color: #c2e7b0; background: #f0f9eb; }
.chapter.round-3 .chapter-name, .chapter.round-3 .chapter-round { color: #67C23A; }

/* 章节右侧细分 + 薄弱 */
.chapter-right { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; margin-left: 8rpx; }
.sub-stage-tag {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #f4f4f5; border: 2rpx solid #e9e9eb;
  font-size: 22rpx; color: #909399;
  display: flex; align-items: center; justify-content: center;
}
.sub-stage-tag.active { background: #409EFF; border-color: #409EFF; color: #fff; }
.weak-mark { font-size: 28rpx; color: #c0c4cc; }
.chapter-weak { border-color: #fbc4c4 !important; background: #fef0f0 !important; }
.chapter-weak .chapter-name { color: #f56c6c !important; }
.chapter-weak .weak-mark { color: #f56c6c; }
.chapter.editable { cursor: pointer; }

/* 轮次分布条 */
.round-dist { display: flex; gap: 12rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.round-chip {
  font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 16rpx;
  background: #f4f4f5; color: #909399; border: 1rpx solid transparent;
}
.round-chip.round-0.filled { color: #c0c4cc; }
.round-chip.round-1.filled { color: #409EFF; background: #ecf5ff; border-color: #b3d8ff; }
.round-chip.round-2.filled { color: #E6A23C; background: #fdf6ec; border-color: #f5dab1; }
.round-chip.round-3.filled { color: #67C23A; background: #f0f9eb; border-color: #c2e7b0; }

/* 编辑 & 趋势区域 */
.progress-actions { display: flex; align-items: center; gap: 16rpx; }
.progress-edit {
  font-size: 26rpx; padding: 6rpx 20rpx; border-radius: 20rpx;
  background: #f4f4f5; color: #606266;
}
.progress-edit.on { background: #409EFF; color: #fff; }
.progress-tip { font-size: 24rpx; color: #E6A23C; background: #fdf6ec; padding: 12rpx 16rpx; border-radius: 8rpx; margin-bottom: 16rpx; }

/* 进度趋势 */
.trend-section { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f2f5; }
.trend-title { font-size: 26rpx; color: #606266; margin-bottom: 16rpx; }
.trend-row { display: flex; align-items: flex-end; margin-bottom: 12rpx; }
.trend-label { width: 100rpx; font-size: 24rpx; color: #909399; flex-shrink: 0; }
.trend-bars { display: flex; align-items: flex-end; gap: 6rpx; height: 80rpx; flex: 1; }
.trend-bar-wrap { display: flex; flex-direction: column; align-items: center; flex: 1; height: 100%; }
.trend-bar {
  width: 100%; max-width: 32rpx; min-height: 4rpx;
  background: linear-gradient(180deg, #409EFF, #66b1ff);
  border-radius: 4rpx 4rpx 0 0; flex: 1;
}
.trend-bar-major { background: linear-gradient(180deg, #E6A23C, #f0b552); }
.trend-val { font-size: 18rpx; color: #909399; margin-top: 4rpx; }

/* 进度条分科目颜色 */
.bar-inner.bar-politics { background: linear-gradient(90deg, #f56c6c, #f78989); }
.bar-inner.bar-english { background: linear-gradient(90deg, #409EFF, #66b1ff); }
.bar-inner.bar-math { background: linear-gradient(90deg, #E6A23C, #f0b552); }
.bar-inner.bar-major { background: linear-gradient(90deg, #67C23A, #85ce61); }

/* 科目 meta 区 */
.subject-meta { display: flex; align-items: center; gap: 8rpx; }
.subject-weak { font-size: 22rpx; color: #f56c6c; background: #fef0f0; padding: 2rpx 10rpx; border-radius: 10rpx; }
