<view class="container">
  <!-- 打卡状态卡 -->
  <view class="card status-card {{checkin.status === 'SUBMITTED' ? 'card-done' : 'card-pending'}}">
    <view class="flex-between">
      <view>
        <view class="status-title">{{checkin.status === 'SUBMITTED' ? '本周已打卡' : '本周未打卡'}}</view>
        <view class="status-sub">{{checkin.weekStartText || '本周'}} (周一至周日)</view>
      </view>
      <view class="status-icon">{{checkin.status === 'SUBMITTED' ? '✓' : '!'}}</view>
    </view>
  </view>

  <!-- 打卡表单(未提交时显示) -->
  <block wx:if="{{checkin.status !== 'SUBMITTED'}}">
    <!-- 第一步:选择当前阶段 -->
    <view class="card">
      <view class="card-title">1. 当前所处阶段 <text class="required">*</text></view>
      <view class="stage-grid">
        <view
          wx:for="{{stages}}"
          wx:key="value"
          class="stage-item {{form.stage === item.value ? 'active' : ''}}"
          bindtap="selectStage"
          data-value="{{item.value}}"
        >
          {{item.label}}
        </view>
      </view>
      <view class="form-row checkbox-row" bindtap="toggleOnlineConfirmation">
        <text class="row-label">已完成网上确认</text>
        <view class="switch {{form.onlineConfirmationCompleted ? 'on' : ''}}">
          <view class="switch-dot"></view>
        </view>
      </view>
      <view class="form-tip" wx:if="{{form.onlineConfirmationCompleted}}">
        ✅ 考研网上确认已完成，加油！
      </view>
      <view class="form-tip" wx:else>
        💡 网上确认是考研报名的关键环节，通常在11月初进行
      </view>
    </view>

    <!-- 第二步:勾选完成事项 -->
    <view class="card">
      <view class="card-title">2. 本周完成事项 <text class="required">*</text></view>
      <view class="check-list">
        <view class="check-item" wx:for="{{checkItems}}" wx:key="id" bindtap="toggleCheckItem" data-id="{{item.id}}">
          <view class="checkbox {{item.checked ? 'checked' : ''}}">
            <text wx:if="{{item.checked}}">✓</text>
          </view>
          <text class="check-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 第三步:填写困难 -->
    <view class="card">
      <view class="card-title">3. 本周备考困难 <text class="required">*</text></view>
      <textarea
        class="textarea"
        placeholder="请描述本周遇到的主要困难,辅导员/导师会据此提供帮扶..."
        value="{{form.difficulties}}"
        bindinput="onDifficultiesInput"
        maxlength="500"
      ></textarea>
    </view>

    <!-- 选填项:学习时长 + 分科进度(可内联编辑) + 趋势 -->
    <view class="card">
      <view class="card-title">4. 补充信息(选填)</view>
      <view class="form-row">
        <text class="row-label">本周学习时长</text>
        <input class="row-input" type="digit" placeholder="小时" value="{{form.studyHours}}" bindinput="onHoursInput" />
      </view>

      <!-- 分科细化进度 -->
      <view class="progress-section" wx:if="{{hasSubjectProgress || subjectView.length > 0}}">
        <view class="progress-head">
          <text class="progress-title">分科复习进度</text>
          <view class="progress-actions">
            <text class="progress-edit {{editMode ? 'on' : ''}}" bindtap="toggleEditMode">{{editMode ? '完成' : '编辑'}}</text>
            <text class="progress-update" bindtap="goUpdateProgress">档案 ›</text>
          </view>
        </view>
        <view class="progress-tip" wx:if="{{editMode}}">💡 点击章节调整轮次,短标调整细分阶段,⭐标记薄弱</view>

        <block wx:if="{{hasSubjectProgress}}">
          <view class="subject" wx:for="{{subjectView}}" wx:for-item="subj" wx:for-index="si" wx:key="key">
            <view class="subject-head">
              <text class="subject-name">{{subj.name}}</text>
              <view class="subject-meta">
                <text class="subject-percent">{{subj.percent}}%</text>
                <text class="subject-weak" wx:if="{{subj.weakCount > 0}}">⭐{{subj.weakCount}}</text>
              </view>
            </view>
            <view class="bar"><view class="bar-inner bar-{{subj.key}}" style="width:{{subj.percent}}%;"></view></view>
            <view class="round-dist">
              <text class="round-chip round-{{rounds[i].v}} {{subj.counts[rounds[i].v] > 0 ? 'filled' : ''}}" wx:for="{{rounds}}" wx:for-index="i" wx:key="v">
                {{rounds[i].label}} {{subj.counts[rounds[i].v]}}
              </text>
            </view>
            <view class="chapter-list">
              <view class="chapter chapter-{{ch.round}} {{ch.weak ? 'chapter-weak' : ''}} {{editMode ? 'editable' : ''}}"
                    wx:for="{{subj.chapters}}" wx:for-item="ch" wx:key="name"
                    bindtap="onChapterRoundTap" data-key="{{subj.key}}" data-idx="{{index}}">
                <text class="chapter-name">{{ch.name}}</text>
                <view class="chapter-right">
                  <view class="sub-stage-tag" catchtap="onChapterSubStageTap" data-key="{{subj.key}}" data-idx="{{index}}"
                        class="{{ch.subStage > 0 ? 'active' : ''}}">
                    {{ch.subStageShort}}
                  </view>
                  <text class="weak-mark" catchtap="onChapterWeakTap" data-key="{{subj.key}}" data-idx="{{index}}">
                    {{ch.weak ? '⭐' : '☆'}}
                  </text>
                </view>
              </view>
            </view>
          </view>

          <!-- 进度趋势 -->
          <view class="trend-section" wx:if="{{trend && (trend.public.length > 1 || trend.major.length > 1)}}">
            <view class="trend-title">📈 近几周进度趋势</view>
            <view class="trend-row" wx:if="{{trend.public.length > 1}}">
              <text class="trend-label">公共课</text>
              <view class="trend-bars">
                <view class="trend-bar-wrap" wx:for="{{trend.public}}" wx:for-item="pt" wx:key="week">
                  <view class="trend-bar" style="height:{{pt.value}}%;"></view>
                  <text class="trend-val">{{pt.value}}</text>
                </view>
              </view>
            </view>
            <view class="trend-row" wx:if="{{trend.major.length > 1}}">
              <text class="trend-label">专业课</text>
              <view class="trend-bars">
                <view class="trend-bar-wrap" wx:for="{{trend.major}}" wx:for-item="pt" wx:key="week">
                  <view class="trend-bar trend-bar-major" style="height:{{pt.value}}%;"></view>
                  <text class="trend-val">{{pt.value}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>

        <!-- 尚未维护分科进度 -->
        <block wx:else>
          <view class="form-row">
            <text class="row-label">公共课进度</text>
            <text class="progress-value">{{archivePublic}}%</text>
          </view>
          <view class="form-row">
            <text class="row-label">专业课进度</text>
            <text class="progress-value">{{archiveMajor}}%</text>
          </view>
          <view class="muted">还没维护分科进度? 点右上角「档案 ›」快速设置</view>
        </block>
      </view>
    </view>

    <button class="btn-submit" bindtap="submit" loading="{{submitting}}">
      提交打卡
    </button>
  </block>

  <!-- 已提交时显示打卡详情 -->
  <block wx:if="{{checkin.status === 'SUBMITTED'}}">
    <view class="card">
      <view class="card-title">本周打卡详情</view>
      <view class="detail-row">
        <text class="detail-label">当前阶段</text>
        <text class="detail-value">{{stageLabelMap[checkin.stage] || checkin.stage}}</text>
      </view>
      <view class="detail-row" wx:if="{{checkin.studyHours}}">
        <text class="detail-label">学习时长</text>
        <text class="detail-value">{{checkin.studyHours}} 小时</text>
      </view>
      <view class="detail-row" wx:if="{{checkin.difficulties}}">
        <text class="detail-label">备考困难</text>
        <text class="detail-value">{{checkin.difficulties}}</text>
      </view>
      <view class="detail-row" wx:if="{{checkin.completedItems && checkin.completedItems.length}}">
        <text class="detail-label">完成事项</text>
        <view class="detail-value">
          <text wx:for="{{checkin.completedItems}}" wx:key="*this" class="tag tag-primary">{{item}}</text>
        </view>
      </view>
      <view class="detail-row" wx:if="{{checkin.onlineConfirmationCompleted}}">
        <text class="detail-label">网上确认</text>
        <text class="detail-value success">✅ 已完成</text>
      </view>

      <!-- 分科进度(只读展示) -->
      <view class="progress-section" wx:if="{{hasSubjectProgress}}">
        <view class="progress-head">
          <text class="progress-title">分科复习进度</text>
          <text class="progress-update" bindtap="goUpdateProgress">更新 ›</text>
        </view>
        <view class="subject" wx:for="{{subjectView}}" wx:for-item="subj" wx:key="key">
          <view class="subject-head">
            <text class="subject-name">{{subj.name}}</text>
            <view class="subject-meta">
              <text class="subject-percent">{{subj.percent}}%</text>
              <text class="subject-weak" wx:if="{{subj.weakCount > 0}}">⭐{{subj.weakCount}}</text>
            </view>
          </view>
          <view class="bar"><view class="bar-inner bar-{{subj.key}}" style="width:{{subj.percent}}%;"></view></view>
          <view class="round-dist">
            <text class="round-chip round-{{rounds[i].v}} {{subj.counts[rounds[i].v] > 0 ? 'filled' : ''}}" wx:for="{{rounds}}" wx:for-index="i" wx:key="v">
              {{rounds[i].label}} {{subj.counts[rounds[i].v]}}
            </text>
          </view>
          <view class="chapter-list">
            <view class="chapter chapter-{{ch.round}} {{ch.weak ? 'chapter-weak' : ''}}" wx:for="{{subj.chapters}}" wx:for-item="ch" wx:key="name">
              <text class="chapter-name">{{ch.name}}</text>
              <view class="chapter-right">
                <view class="sub-stage-tag {{ch.subStage > 0 ? 'active' : ''}}">{{ch.subStageShort}}</view>
                <text class="weak-mark">{{ch.weak ? '⭐' : '☆'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="detail-row" wx:elif="{{archivePublic || archiveMajor}}">
        <text class="detail-label">总体进度</text>
        <text class="detail-value">公共课 {{archivePublic}}% · 专业课 {{archiveMajor}}%</text>
      </view>
    </view>

    <button class="btn-makeup" bindtap="applyMakeup" wx:if="{{checkin.canMakeup}}">
      申请补卡
    </button>
  </block>

  <!-- 打卡历史 -->
  <view class="card">
    <view class="card-title">打卡历史</view>
    <view class="history-item" wx:for="{{history}}" wx:key="weekStart">
      <view class="history-week">{{item.weekStartText || item.weekStart}}</view>
      <view class="history-status">
        <text class="tag {{item.status === 'SUBMITTED' ? 'tag-success' : 'tag-danger'}}">
          {{item.status === 'SUBMITTED' ? '已打卡' : '未打卡'}}
        </text>
      </view>
    </view>
  </view>
</view>
<view class="app-tab-bar">
  <view class="tab-item {{tabActive === item.key ? 'active' : ''}}" wx:for="{{tabItems}}" wx:key="key" data-path="{{item.path}}" data-key="{{item.key}}" bindtap="onTabTap">
    <view class="icon">{{item.icon}}</view>
    <view class="text">{{item.text}}</view>
  </view>
</view>
