/* pages/privacy/privacy.wxss */
.privacy-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.privacy-header {
  background: linear-gradient(135deg, #409EFF, #36a3ff);
  padding: 60rpx 40rpx 50rpx;
}

.privacy-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.privacy-body {
  padding: 30rpx 40rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-heading {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
