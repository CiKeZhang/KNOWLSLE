/* pages/mentor-dashboard/mentor-dashboard.wxss */
.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.stat-card.warn {
  background: linear-gradient(135deg, #fff5f5, #ffe8e8);
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #409eff;
  margin-bottom: 8rpx;
}

.stat-card.warn .stat-num {
  color: #f56c6c;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
}

.section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.stage-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.stage-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
}

.stage-bar {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.stage-fill {
  height: 100%;
  background: linear-gradient(90deg, #409eff, #66b1ff);
  border-radius: 12rpx;
}

.stage-count {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

/* 按专业统计 */
.major-item { margin-bottom: 24rpx; }
.major-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.major-name { font-size: 28rpx; color: #303133; font-weight: 500; }
.major-count { font-size: 24rpx; color: #909399; }
.major-bar {
  height: 20rpx;
  background: #ebeef5;
  border-radius: 10rpx;
  overflow: hidden;
}
.major-fill {
  height: 100%;
  background: linear-gradient(90deg, #409eff, #67c23a);
  border-radius: 10rpx;
  transition: width 0.3s;
}
