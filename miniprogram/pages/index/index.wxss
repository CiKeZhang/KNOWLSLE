.user-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info { flex: 1; }
.user-name { font-size: 32rpx; font-weight: 600; }
.user-sub { font-size: 24rpx; color: #909399; margin-top: 4rpx; }

.checkin-card {
  background: linear-gradient(135deg, #409EFF 0%, #337ecc 100%);
  color: #fff;
}

.checkin-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; color: #fff; }
.checkin-card .muted { color: rgba(255,255,255,0.85); }
.checkin-status {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.checkin-status.done { background: #67C23A; color: #fff; }
.checkin-status.pending { background: rgba(255,255,255,0.25); color: #fff; }

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.grid-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  text-align: center;
}

.grid-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.grid-text { font-size: 24rpx; color: #606266; }

.timeline-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.timeline-item:last-child { border-bottom: none; }

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #409EFF;
  margin-right: 20rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.timeline-content { flex: 1; }
.timeline-title { font-size: 28rpx; margin-bottom: 4rpx; }

.node-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  display: flex;
  justify-content: space-between;
}

.node-item:last-child { border-bottom: none; }

.empty {
  text-align: center;
  color: #909399;
  padding: 40rpx 0;
}
