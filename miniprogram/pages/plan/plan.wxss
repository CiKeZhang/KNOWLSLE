.period-switch { display: flex; gap: 24rpx; }
.period { font-size: 30rpx; color: #909399; padding: 8rpx 0; }
.period.active { color: #409EFF; font-weight: 600; border-bottom: 4rpx solid #409EFF; }
.regenerate { color: #409EFF; font-size: 26rpx; }
.task-list { display: flex; flex-direction: column; gap: 20rpx; }
.task-item { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.checkbox { width: 40rpx; height: 40rpx; border: 2rpx solid #dcdfe6; border-radius: 8rpx; margin-right: 16rpx; display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; }
.checkbox.checked { background: #67C23A; border-color: #67C23A; }
.task-content { flex: 1; }
.task-text { font-size: 28rpx; margin-bottom: 8rpx; }
.task-text.done { text-decoration: line-through; color: #909399; }
.task-input { width: 100%; font-size: 28rpx; border-bottom: 1rpx solid #e4e7ed; padding-bottom: 4rpx; }
.task-meta { display: flex; gap: 12rpx; align-items: center; }
.plan-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-edit, .btn-add, .btn-save, .btn-cancel { flex: 1; font-size: 28rpx; border-radius: 32rpx; }
.btn-edit { background: #f5f7fa; color: #606266; }
.btn-add { background: #67C23A; color: #fff; }
.btn-save { background: #409EFF; color: #fff; }
.btn-cancel { background: #f5f7fa; color: #606266; }
