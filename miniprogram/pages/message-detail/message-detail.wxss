/* pages/message-detail/message-detail.wxss */

.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.msg-card.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.msg-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #dfe8f5;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #909399;
  font-weight: 500;
}

.user-meta {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #303133;
  margin-bottom: 4rpx;
}

.msg-time {
  font-size: 22rpx;
  color: #909399;
}

.delete-btn {
  font-size: 24rpx;
  color: #f56c6c;
  padding: 8rpx 16rpx;
}

.msg-content {
  font-size: 30rpx;
  color: #303133;
  line-height: 1.7;
  margin-bottom: 24rpx;
  word-break: break-all;
}

.msg-footer {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f6fc;
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  color: #909399;
  font-size: 24rpx;
}

.action-item.liked {
  color: #f56c6c;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 24rpx;
}

/* 回复区 */
.reply-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
}

.reply-list {
  padding-top: 8rpx;
}

.reply-item {
  display: flex;
  margin-bottom: 28rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #dfe8f5;
  font-size: 22rpx;
}

.reply-body {
  flex: 1;
  min-width: 0;
}

.reply-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.reply-name {
  font-size: 26rpx;
  color: #606266;
  font-weight: 500;
  margin-right: 16rpx;
}

.reply-time {
  font-size: 22rpx;
  color: #c0c4cc;
}

.reply-content {
  font-size: 26rpx;
  color: #303133;
  line-height: 1.6;
  word-break: break-all;
}

.empty-reply {
  text-align: center;
  padding: 60rpx 0;
  color: #c0c4cc;
  font-size: 26rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #909399;
}

/* 底部回复栏 */
.reply-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
}

.reply-input-wrap {
  flex: 1;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
}

.reply-input {
  height: 72rpx;
  font-size: 28rpx;
  line-height: 72rpx;
}

.anon-toggle {
  font-size: 22rpx;
  color: #909399;
  padding: 0 12rpx;
  margin-right: 8rpx;
  white-space: nowrap;
}

.anon-toggle.active {
  color: #409eff;
}

.send-btn {
  min-width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #409eff 0%, #36a3f7 100%);
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  border: none;
}

.send-btn[disabled] {
  background: #dcdfe6;
  color: #fff;
}
