<view class="container" wx:if="{{message}}">
  <!-- 主留言 -->
  <view class="msg-card detail-card">
    <view class="msg-header">
      <view class="user-info">
        <image wx:if="{{message.user.avatarUrl}}" class="avatar" src="{{message.user.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-placeholder">{{message.isAnonymous ? '匿' : message.user.name[0]}}</view>
        <view class="user-meta">
          <view class="user-name">{{message.isAnonymous ? '匿名用户' : message.user.name}}</view>
          <view class="msg-time">{{message.timeText}}</view>
        </view>
      </view>
      <view wx:if="{{message.isMine}}" class="delete-btn" bindtap="deleteMessage">删除</view>
    </view>
    <view class="msg-content">{{message.content}}</view>
    <view class="msg-footer">
      <view class="action-item {{message.isLiked ? 'liked' : ''}}" bindtap="toggleLike">
        <text class="action-icon">{{message.isLiked ? '❤️' : '🤍'}}</text>
        <text class="action-text">{{message.likeCount}} 赞</text>
      </view>
      <view class="action-item">
        <text class="action-icon">💬</text>
        <text class="action-text">{{message.replyCount}} 回复</text>
      </view>
    </view>
  </view>

  <!-- 回复区 -->
  <view class="reply-section">
    <view class="section-title">全部回复 ({{replies.length}})</view>

    <view class="reply-list">
      <view class="reply-item" wx:for="{{replies}}" wx:key="id">
        <image wx:if="{{item.user.avatarUrl}}" class="reply-avatar" src="{{item.user.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="reply-avatar avatar-placeholder">{{item.isAnonymous ? '匿' : item.user.name[0]}}</view>
        <view class="reply-body">
          <view class="reply-header">
            <text class="reply-name">{{item.isAnonymous ? '匿名用户' : item.user.name}}</text>
            <text class="reply-time">{{item.timeText}}</text>
          </view>
          <view class="reply-content">{{item.content}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{replies.length === 0}}" class="empty-reply">
      <text>暂无回复，来说两句吧~</text>
    </view>
  </view>
</view>

<view wx:if="{{loading}}" class="loading">加载中...</view>

<!-- 底部回复框 -->
<view class="reply-bar" wx:if="{{message}}">
  <view class="reply-input-wrap">
    <input
      class="reply-input"
      placeholder="写下你的回复..."
      value="{{replyContent}}"
      bindinput="onReplyInput"
      maxlength="300"
      confirm-type="send"
      bindconfirm="submitReply"
    />
  </view>
  <view class="anon-toggle {{isAnonymous ? 'active' : ''}}" bindtap="toggleAnonymous">
    {{isAnonymous ? '🔒 匿名' : '🙂 实名'}}
  </view>
  <button class="send-btn" bindtap="submitReply" disabled="{{submitting || !replyContent.trim()}}" loading="{{submitting}}">
    发送
  </button>
</view>
