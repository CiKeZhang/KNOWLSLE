# Frontend
FRONTEND_PORT=8080

# AI 大模型(用于择校推荐的自然语言解释与对话,可选;不配置则仅使用规则算法)
# 支持 OpenAI 兼容接口:智谱 GLM / 通义 / DeepSeek / OpenAI 等
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
