# 复制为 .env 并修改默认密码/密钥后使用

# MySQL
MYSQL_ROOT_PASSWORD=kygl_root_2026
MYSQL_DATABASE=kygl
MYSQL_USER=kygl
MYSQL_PASSWORD=kygl_pwd_2026
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=kygl_redis_2026
